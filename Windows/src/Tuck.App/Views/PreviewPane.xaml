<UserControl x:Class="Tuck.App.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Tuck.Text}">
    <Grid>
        <TextBlock Text="No item selected" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Tuck.TextSecondary}"
                   Visibility="{Binding Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />

        <DockPanel Visibility="{Binding Converter={StaticResource NullToVisibility}}">
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Height="44" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource Tuck.Icons}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource Tuck.TextSecondary}" />
                <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Tuck.TextSecondary}" />
                <TextBlock Grid.Column="2" Text="&#xE840;" FontFamily="{StaticResource Tuck.Icons}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource Tuck.Amber}" ToolTip="Pinned"
                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Tuck.Border}" />

            <!-- Details -->
            <Grid DockPanel.Dock="Bottom" Margin="14,10" TextBlock.FontSize="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Source" Margin="0,0,10,4" HorizontalAlignment="Right" Foreground="{DynamicResource Tuck.TextSecondary}"
                           Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4"
                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}">
                    <Image Source="{Binding SourceIcon}" Width="14" Height="14" Margin="0,0,4,0"
                           Visibility="{Binding SourceIcon, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Copied" Margin="0,0,10,4" HorizontalAlignment="Right" Foreground="{DynamicResource Tuck.TextSecondary}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CopiedLong}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="2" Text="Size" Margin="0,0,10,4" HorizontalAlignment="Right" Foreground="{DynamicResource Tuck.TextSecondary}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeText}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="3" Text="Deletes" Margin="0,0,10,0" HorizontalAlignment="Right" Foreground="{DynamicResource Tuck.TextSecondary}"
                           Visibility="{Binding HasExpiry, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpiresText}"
                           Visibility="{Binding HasExpiry, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Tuck.Border}" />

            <!-- Content -->
            <Grid>
                <TextBox Text="{Binding FullText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="14,10"
                         VerticalScrollBarVisibility="Auto" FontSize="12"
                         Visibility="{Binding ShowFullText, Converter={StaticResource BoolToVisibility}}"
                         AutomationProperties.Name="Full text">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource Tuck.PlainTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseMonospace}" Value="True">
                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14"
                            Visibility="{Binding ShowSecretMask, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Tuck.Icons}" FontSize="22" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Tuck.TextTertiary}" />
                    <TextBlock Text="Hidden because it looks like a secret" FontSize="12" Margin="0,10" TextAlignment="Center"
                               Foreground="{DynamicResource Tuck.TextSecondary}" />
                    <Button Content="Show" HorizontalAlignment="Center" Padding="14,3" Click="OnRevealSecret" />
                </StackPanel>

                <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="14" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Files}" Margin="14,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,8,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Tuck.TextSecondary}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

<Window x:Class="Tuck.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tuck.App.Views"
        xmlns:vm="clr-namespace:Tuck.App.ViewModels"
        Title="Tuck"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Tuck.Font}"
        Foreground="{DynamicResource Tuck.Text}">
    <Window.Resources>
        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,4" Margin="0,1" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tuck.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tuck.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Tuck.Amber}" VerticalAlignment="Center"
                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" ToolTip="Pinned" />
                <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                    <Border Width="48" Height="32" CornerRadius="4" HorizontalAlignment="Left"
                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <DockPanel Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="{StaticResource Tuck.Icons}" FontSize="10"
                                   Margin="0,4,4,0" Foreground="{DynamicResource Tuck.TextSecondary}"
                                   Visibility="{Binding IsSecret, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding DisplayText}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                   MaxHeight="{Binding DataContext.Settings.RowLines, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource LinesToHeight}}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding DataContext.Settings.ShowMetadata, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding SourceIcon}" Width="14" Height="14" Margin="0,0,4,0"
                               Visibility="{Binding SourceIcon, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="{DynamicResource Tuck.TextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" Margin="4,0"
                        Background="{DynamicResource Tuck.Accent}" VerticalAlignment="Center"
                        Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{Binding QueuePosition, StringFormat=Position {0} in the paste queue}">
                    <TextBlock Text="{Binding QueuePosition}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Tuck.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding ShortcutHint}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource Tuck.TextSecondary}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="16" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource Tuck.Surface}" BorderBrush="{DynamicResource Tuck.Border}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" />
        </Border.Effect>
        <Grid Height="460">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <!-- Search -->
                <Grid DockPanel.Dock="Top" Height="44" Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Tuck.Icons}" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource Tuck.TextSecondary}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="Search clipboard" FontSize="15" VerticalAlignment="Center"
                               Foreground="{DynamicResource Tuck.TextTertiary}" IsHitTestVisible="False"
                               Visibility="{Binding HasQuery, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0" FontSize="15" VerticalAlignment="Center"
                             Style="{StaticResource Tuck.PlainTextBox}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search clipboard" />
                    <Button Grid.Column="2" Style="{StaticResource Tuck.IconButton}" Content="&#xE711;" Click="OnClearSearch"
                            ToolTip="Clear search" AutomationProperties.Name="Clear search"
                            Visibility="{Binding HasQuery, Converter={StaticResource BoolToVisibility}}" />
                    <ToggleButton Grid.Column="3" Style="{StaticResource Tuck.IconToggle}" Content="&#xE89F;"
                                  IsChecked="{Binding Settings.ShowPreview}"
                                  ToolTip="Show or hide preview (Alt+P)" AutomationProperties.Name="Preview pane" />
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Tuck.Border}" />

                <!-- Paste queue banner -->
                <StackPanel DockPanel.Dock="Top" Visibility="{Binding ShowQueueBanner, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="{StaticResource Tuck.Icons}" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Tuck.Accent}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE8FD;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollecting}" Value="True">
                                            <Setter Property="Text" Value="&#xE7C8;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Margin="8,0">
                            <TextBlock Text="{Binding QueueTitle}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding QueueHint}" FontSize="11" Foreground="{DynamicResource Tuck.TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnToggleCollecting" Padding="10,2" Margin="0,0,6,0" FontSize="12"
                                ToolTip="Add every new copy to the queue, or stop doing so">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Collect" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollecting}" Value="True">
                                            <Setter Property="Content" Value="Stop" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="3" Content="Clear" Click="OnClearQueue" Padding="10,2" FontSize="12" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Tuck.Border}" />
                </StackPanel>

                <!-- Key hints -->
                <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding Settings.ShowKeyHints, Converter={StaticResource BoolToVisibility}}">
                    <Border Height="1" Background="{DynamicResource Tuck.Border}" />
                    <TextBlock Height="28" Padding="0,7,0,0" HorizontalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource Tuck.TextSecondary}">
                        <Run FontWeight="SemiBold" Text="Enter" /> paste
                        <Run FontWeight="SemiBold" Text="   Tab" /> queue
                        <Run FontWeight="SemiBold" Text="   Alt+P" /> preview
                        <Run FontWeight="SemiBold" Text="   Ctrl+P" /> pin
                        <Run FontWeight="SemiBold" Text="   Shift+Del" /> delete
                    </TextBlock>
                </StackPanel>

                <!-- List -->
                <Grid>
                    <ListBox x:Name="ItemsList" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding Selected}"
                             ItemTemplate="{StaticResource ItemTemplate}" ItemContainerStyle="{StaticResource ItemStyle}"
                             Background="Transparent" BorderThickness="0" Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="OnSelectionChanged" Focusable="False"
                             AutomationProperties.Name="Clipboard history" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Tuck.Icons}" FontSize="24" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Tuck.TextTertiary}" />
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Tuck.TextSecondary}" />
                        <TextBlock Text="{Binding EmptyHint}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Tuck.TextTertiary}" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <Border Grid.Column="1" Width="1" Background="{DynamicResource Tuck.Border}"
                    Visibility="{Binding Settings.ShowPreview, Converter={StaticResource BoolToVisibility}}" />
            <views:PreviewPane Grid.Column="2" Width="320" DataContext="{Binding Selected}"
                               Visibility="{Binding DataContext.Settings.ShowPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Border>
</Window>

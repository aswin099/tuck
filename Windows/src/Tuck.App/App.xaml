<Application x:Class="Tuck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Tuck.App.Views"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <Application.Resources>
        <FontFamily x:Key="Tuck.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
        <!-- Windows 11 ships Segoe Fluent Icons; Windows 10 has the older Segoe MDL2 Assets with the same code points. -->
        <FontFamily x:Key="Tuck.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
        <views:LinesToHeightConverter x:Key="LinesToHeight" />
        <views:ZeroToVisibleConverter x:Key="ZeroToVisible" />
        <views:NotNullConverter x:Key="NotNull" />

        <!-- A text box with no border or background, for the search field and the preview text. -->
        <Style x:Key="Tuck.PlainTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Tuck.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Tuck.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Tuck.Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}" Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square buttons with a Segoe Fluent Icons glyph. -->
        <Style x:Key="Tuck.IconButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="{StaticResource Tuck.Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Tuck.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tuck.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tuck.IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource Tuck.IconButton}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Tuck.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
